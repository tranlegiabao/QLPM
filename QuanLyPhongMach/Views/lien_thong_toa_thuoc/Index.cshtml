@{
    var canSend = ViewBag.CanSend as bool? ?? false;
}
<section class="container-fluid py-2 ltt-workspace" id="ltt-root" data-can-send="@(canSend ? "1" : "0")">
    <div class="card h-100">
        <div class="card-header py-2"><h5 class="mb-0">Liên thông toa thuốc quốc gia</h5></div>
        <div class="card-body py-2 border-bottom">
            <div class="row g-2 align-items-end">
                <div class="col-md-2"><label for="ltt-tu-ngay" class="form-label small mb-1">Từ ngày</label><input id="ltt-tu-ngay" class="form-control form-control-sm" placeholder="dd-MM-yyyy" autocomplete="off" /></div>
                <div class="col-md-2"><label for="ltt-den-ngay" class="form-label small mb-1">Đến ngày</label><input id="ltt-den-ngay" class="form-control form-control-sm" placeholder="dd-MM-yyyy" autocomplete="off" /></div>
                <div class="col-md-3"><label for="ltt-bac-si" class="form-label small mb-1">Bác sĩ kê</label><select id="ltt-bac-si" class="form-select form-select-sm"><option value="">Tất cả bác sĩ</option></select></div>
                <div class="col-md-2"><label for="ltt-ma-toa" class="form-label small mb-1">Mã toa</label><input id="ltt-ma-toa" class="form-control form-control-sm" maxlength="100" placeholder="Nhập mã toa" /></div>
                <div class="col-md-3"><label for="ltt-ma-vv" class="form-label small mb-1">Mã lượt khám</label><input id="ltt-ma-vv" class="form-control form-control-sm" maxlength="100" placeholder="Nhập mã lượt khám" /></div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
                <fieldset class="d-flex flex-wrap gap-3 border rounded px-3 py-2">
                    <legend class="float-none w-auto small mb-0 px-1">Trạng thái</legend>
                    <label class="form-check mb-0"><input type="radio" class="form-check-input" name="ltt-trang-thai" value="" checked />Tất cả</label>
                    <label class="form-check mb-0"><input type="radio" class="form-check-input" name="ltt-trang-thai" value="DA_LIEN_THONG" />Đã liên thông</label>
                    <label class="form-check mb-0"><input type="radio" class="form-check-input" name="ltt-trang-thai" value="CHUA_LIEN_THONG" />Chưa liên thông</label>
                </fieldset>
                <button type="button" id="ltt-tim" class="btn btn-outline-primary btn-sm"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
                @if (canSend) { <button type="button" id="ltt-gui" class="btn btn-primary btn-sm" disabled><i class="bi bi-cloud-arrow-up me-1"></i>Liên thông</button> }
                <span class="small text-muted" id="ltt-selected"></span>
            </div>
        </div>
        <div class="table-responsive flex-grow-1 ltt-table-scroll" id="ltt-table-scroll">
            <table class="table table-sm table-bordered table-hover align-middle text-nowrap mb-0">
                <thead class="table-light sticky-top"><tr>
                    <th class="text-center"><input id="ltt-check-all" type="checkbox" class="form-check-input" aria-label="Chọn tất cả toa có thể gửi trên trang" disabled="@(!canSend)" /></th>
                    <th>Bác sĩ kê</th><th>Ngày kê</th><th>Mã toa</th><th>Loại toa</th><th>Mã BN</th><th>Tên bệnh nhân</th><th>Mã lượt khám</th><th>Trạng thái</th><th class="text-center">TB trả về</th>
                </tr></thead>
                <tbody id="ltt-body"><tr><td colspan="10" class="text-center text-muted py-4">Đang tải...</td></tr></tbody>
            </table>
        </div>
        <div class="d-flex border-top align-items-center"><span class="small text-muted px-2" id="ltt-total"></span><div class="qlpm-pagination-bar flex-grow-1" id="ltt-pagination"></div></div>
    </div>
</section>
<div class="modal fade" id="ltt-detail-modal" tabindex="-1" aria-labelledby="ltt-detail-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 id="ltt-detail-title" class="modal-title">Thông tin gửi đơn thuốc</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body"><pre class="bg-light border rounded p-3 small mb-0" id="ltt-detail"></pre></div>
    </div></div>
</div>
<div class="modal fade" id="ltt-progress-modal" tabindex="-1" aria-labelledby="ltt-progress-title" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h5 id="ltt-progress-title" class="modal-title">Liên thông toa thuốc</h5></div>
        <div class="modal-body"><p id="ltt-progress-status" role="status"></p><div id="ltt-progress-results" aria-live="polite"></div></div>
        <div class="modal-footer"><button type="button" id="ltt-progress-close" class="btn btn-secondary" data-bs-dismiss="modal" disabled>Đóng</button></div>
    </div></div>
</div>
@section Scripts { <script src="~/js/lien_thong_toa_thuoc/index.js" asp-append-version="true"></script> }
