@{
    ViewData["Title"] = "Khám bệnh";
    var targetIdVaoVien = ViewBag.TargetIdVaoVien as long?;
    var canSuaKham = ViewBag.CanSuaKham is bool canSua && canSua;
}

<div class="qlpm-page-root kham-benh-layout" id="kham-benh-root" data-target-id-vaovien="@(targetIdVaoVien?.ToString() ?? "")" data-can-sua-kham="@(canSuaKham ? "true" : "false")">
    <!-- CỘT TRÁI: DANH SÁCH BỆNH NHÂN KHÁM (~300px) -->
    <section class="qlpm-pane-left kham-benh-list" aria-label="Danh sách bệnh nhân khám">
        <div class="border-bottom pb-2 mb-2">
            <!-- Ô ngày thu nhỏ, không icon không chữ 'Ngày', nằm cạnh ô tìm kiếm -->
            <div class="d-flex gap-1 mb-2">
                <input type="text" id="kb-filter-ngay" class="form-control form-control-sm text-center" style="width: 105px; flex-shrink: 0;" placeholder="dd-mm-yyyy" />
                <div class="input-group input-group-sm flex-grow-1">
                    <input type="text" id="kb-filter-tu-khoa" class="form-control" placeholder="Tìm BN..." />
                    <button class="btn btn-outline-secondary px-2" type="button" id="btn-kb-tim-kiem" title="Tìm kiếm"><i class="bi bi-search"></i></button>
                </div>
            </div>

            <!-- Bộ lọc trạng thái & Nút Tải danh sách -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                <div class="kham-benh-status-filter d-flex gap-2">
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="radio" name="kb-filter-trang-thai" id="kb-rad-chua-kham" value="0" checked />
                        <label class="form-check-label text-status-chua-kham small" for="kb-rad-chua-kham">Chưa</label>
                    </div>
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="radio" name="kb-filter-trang-thai" id="kb-rad-dang-kham" value="1" />
                        <label class="form-check-label text-status-dang-kham small" for="kb-rad-dang-kham">Đang</label>
                    </div>
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="radio" name="kb-filter-trang-thai" id="kb-rad-da-kham" value="2" />
                        <label class="form-check-label text-status-da-kham small" for="kb-rad-da-kham">Xong</label>
                    </div>
                    <div class="form-check form-check-inline m-0">
                        <input class="form-check-input" type="radio" name="kb-filter-trang-thai" id="kb-rad-tat-ca" value="" />
                        <label class="form-check-label small" for="kb-rad-tat-ca">Tất cả</label>
                    </div>
                </div>
                <button class="btn btn-primary btn-sm btn-load-list py-0 px-2" type="button" id="btn-kb-reload" title="Tải lại danh sách bệnh nhân">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>

        <!-- Bảng danh sách bệnh nhân: Cột Mã BN đem xuống cuối trước cột Lịch sử -->
        <div class="qlpm-table-container kham-benh-table-wrap flex-grow-1">
            <table class="table table-bordered qlpm-table table-sm m-0" id="kb-table">
                <thead>
                    <tr>
                        <th class="col-sticky-stt kb-patient-stt-column text-center" style="width: 34px; min-width: 34px; max-width: 34px;">STT</th>
                        <th class="kb-patient-name-column">Tên</th>
                        <th class="text-center" style="width: 45px;">NS</th>
                        <th class="text-center" style="width: 40px;">GT</th>
                        <th style="width: 75px;">Mã BN</th>
                        <th class="text-center col-sticky-ls kb-history-col" style="width: 32px; min-width: 32px; max-width: 32px;">LS</th>
                    </tr>
                </thead>
                <tbody id="kb-table-body">
                    <tr><td colspan="6" class="text-center text-muted py-4">Đang tải danh sách...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="qlpm-pagination-bar mt-auto" id="kb-pagination"></div>
    </section>

    <!-- CỘT GIỮA: ĐIỀU HƯỚNG NHANH CÁC VÙNG NHẬP LIỆU -->
    <aside class="kham-benh-section-nav" aria-label="Điều hướng nội dung khám bệnh">
        <button type="button" class="kb-section-nav-btn active" data-target="kb-section-thong-tin" data-bs-toggle="tooltip" data-bs-placement="right" title="1. Thông tin bệnh nhân & Phác đồ" aria-label="Thông tin bệnh nhân và phác đồ">
            <i class="bi bi-person-vcard"></i>
        </button>
        <button type="button" class="kb-section-nav-btn" data-target="kb-section-sinh-hieu" data-bs-toggle="tooltip" data-bs-placement="right" title="2. Sinh hiệu" aria-label="Sinh hiệu">
            <i class="bi bi-heart-pulse"></i>
        </button>
        <button type="button" class="kb-section-nav-btn" data-target="kb-section-trieu-chung" data-bs-toggle="tooltip" data-bs-placement="right" title="3. Triệu chứng & Bệnh sử" aria-label="Triệu chứng">
            <i class="bi bi-chat-left-text"></i>
        </button>
        <button type="button" class="kb-section-nav-btn" data-target="kb-section-chan-doan" data-bs-toggle="tooltip" data-bs-placement="right" title="4. Chẩn đoán bệnh (ICD-10)" aria-label="Chẩn đoán bệnh">
            <i class="fa-solid fa-stethoscope"></i>
        </button>
        <button type="button" class="kb-section-nav-btn" data-target="kb-section-chi-dinh" data-bs-toggle="tooltip" data-bs-placement="right" title="5. Chỉ định Cận lâm sàng" aria-label="Chỉ định Cận lâm sàng">
            <i class="bi bi-clipboard2-pulse"></i>
        </button>
        <button type="button" class="kb-section-nav-btn" data-target="kb-section-toa-thuoc" data-bs-toggle="tooltip" data-bs-placement="right" title="6. Toa thuốc điều trị" aria-label="Toa thuốc điều trị">
            <i class="bi bi-capsule"></i>
        </button>
    </aside>

    <!-- CỘT PHẢI: VÙNG KHÁM BỆNH DẠNG CUỘN -->
    <section class="qlpm-pane-right kham-benh-form-pane" aria-label="Nội dung khám bệnh">
        <div id="kb-empty-state" class="text-center my-auto py-5 text-muted">
            <i class="bi bi-clipboard2-pulse fs-1 text-secondary mb-2 d-block"></i>
            <h6 class="fw-bold">Chưa chọn bệnh nhân</h6>
            <p class="small mb-0">Vui lòng chọn một bệnh nhân từ danh sách bên trái để bắt đầu khám bệnh.</p>
        </div>

        <div id="kb-detail-container" class="d-none d-flex flex-column h-100">
            <div class="kb-entry-scroll flex-grow-1" id="kb-entry-scroll">
                <!-- 1. THÔNG TIN BN + PHÁC ĐỒ -->
                <section class="kb-scroll-section section-box kb-lines-1" id="kb-section-thong-tin" data-kb-section>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="section-title kb-compact-title mb-0">
                            <i class="bi bi-person-vcard me-1"></i> Thông tin:
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1" id="kb-patient-header-bar">
                            <div class="d-flex align-items-center gap-1 kb-info-name">
                                @* <span class="kb-info-separator" aria-hidden="true">|</span> *@
                                <input type="text" id="kb-header-ho-ten"
                                       class="form-control-plaintext p-0 m-0 fw-bold text-uppercase text-primary kb-info-value"
                                       readonly tabindex="-1" aria-readonly="true" />
                            </div>
                            <div class="d-flex align-items-center gap-1 kb-info-birth">
                                <span class="kb-info-label">Ngày sinh:</span>
                                <input type="text" id="kb-header-nam-sinh"
                                       class="form-control-plaintext p-0 m-0 fw-semibold text-dark kb-info-value"
                                       readonly tabindex="-1" aria-readonly="true" />
                            </div>
                            <div class="d-flex align-items-center gap-1 kb-info-gender">
                                <span class="kb-info-label">Giới tính:</span>
                                <input type="text" id="kb-header-gioi-tinh-text"
                                       class="form-control-plaintext p-0 m-0 fw-semibold text-dark kb-info-value"
                                       readonly tabindex="-1" aria-readonly="true" />
                                <select id="kb-header-gioi-tinh" class="d-none"></select>
                            </div>
                            <div class="d-flex align-items-center gap-1 kb-info-regimen">
                                <span class="kb-info-label">Phác đồ:</span>
                                <div class="flex-grow-1 min-w-0">
                                    <select id="kb-select-phac-do" class="form-select form-select-sm" placeholder="-- Chọn --"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Vùng lâm sàng: Sinh hiệu + Triệu chứng + Chẩn đoán -->
                <div class="kb-clinical-group" aria-label="Sinh hiệu, triệu chứng và chẩn đoán">
                <!-- 2-3. SINH HIỆU -->
                <section class="kb-scroll-section section-box kb-lines-2" id="kb-section-sinh-hieu" data-kb-section>
                    <div class="d-flex align-items-start gap-2">
                        <div class="section-title kb-compact-title mb-0 pt-1">
                            <i class="bi bi-heart-pulse me-1 text-danger"></i> Sinh hiệu:
                        </div>
                        <div class="sinh-hieu-box-inline flex-grow-1">
                            <div class="row g-1 mb-1 align-items-center">
                                <div class="col-xl-2 col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">Mạch</span><input type="text" inputmode="decimal" id="sh-mach" class="form-control text-center py-0" placeholder="Lần/P" /></div>
                                </div>
                                <div class="col-xl-2 col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">Nhiệt độ</span><input type="text" inputmode="decimal" id="sh-nhiet-do" class="form-control text-center py-0" placeholder="°C" /></div>
                                </div>
                                <div class="col-xl-3 col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">Huyết áp</span><div class="kb-blood-pressure-inputs form-control py-0"><input type="text" inputmode="numeric" id="sh-huyet-ap-tam-thu" class="text-center" aria-label="Huyết áp" /><span aria-hidden="true">/</span><input type="text" inputmode="numeric" id="sh-huyet-ap-tam-truong" class="text-center" aria-label="Huyết áp tâm trương" /></div><input type="hidden" id="sh-huyet-ap" /></div>
                                </div>
                                <div class="col-xl-2 col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">Nhịp thở</span><input type="text" inputmode="decimal" id="sh-nhip-tho" class="form-control text-center py-0" placeholder="Lần/P" /></div>
                                </div>
                                <div class="col-xl-3 col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">SpO2</span><input type="text" inputmode="decimal" id="sh-spo2" class="form-control text-center py-0" placeholder="%" /></div>
                                </div>
                            </div>
                            <div class="row g-1 align-items-center">
                                <div class="col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">Chiều cao</span><input type="text" inputmode="decimal" id="sh-chieu-cao" class="form-control text-center py-0" placeholder="cm" /></div>
                                </div>
                                <div class="col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">Cân nặng</span><input type="text" inputmode="decimal" id="sh-can-nang" class="form-control text-center py-0" placeholder="Kg" /></div>
                                </div>
                                <div class="col-md-4 col-6">
                                    <div class="input-group input-group-sm"><span class="input-group-text py-0">BMI</span><input type="text" id="sh-bmi" class="form-control text-center fw-bold text-primary py-0" readonly placeholder="--" /></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 4-5. TRIỆU CHỨNG -->
                <section class="kb-scroll-section section-box kb-lines-1" id="kb-section-trieu-chung" data-kb-section>
                    <div class="input-group input-group-sm kb-inline-input-title">
                        <span class="input-group-text fw-semibold kb-trieu-chung-label" id="kb-label-trieu-chung">
                            <i class="bi bi-chat-heart-fill me-1 text-danger"></i> Triệu chứng:
                        </span>
                        <textarea id="kb-trieu-chung" class="form-control" rows="1" placeholder="Nhập lý do khám, bệnh sử..." title="Nhấp chuột phải để tạo/quản lý cụm từ viết tắt"></textarea>
                    </div>
                </section>

                <!-- 6-10. CHẨN ĐOÁN BỆNH -->
                <section class="kb-scroll-section section-box kb-lines-5" id="kb-section-chan-doan" data-kb-section>
                    <div class="kb-title-content-row kb-section-title-content">
                        <div class="section-title kb-compact-title mb-0"><i class="fa-solid fa-stethoscope me-1"></i> Chẩn đoán:</div>
                        <div class="kb-title-content-body kb-section-content">
                            <div class="d-flex align-items-center gap-1 mb-1 kb-inline-section-toolbar">
                                <div class="kb-compact-selector kb-diagnosis-selector">
                                    <select id="kb-select-icd10" placeholder="Mã / tên bệnh"></select>
                                </div>
                            </div>
                            <div class="table-responsive table-scroll-container border rounded kb-fixed-table-wrap kb-icd-scroll">
                                <table class="table table-sm table-bordered m-0 grid-mini qlpm-one-line-head" id="kb-table-icd10">
                                    <thead>
                                        <tr>
                                            <th style="width: 90px;">Mã bệnh</th>
                                            <th>Tên bệnh</th>
                                            <th style="width: 45px;" class="text-center">BĐ</th>
                                            <th style="width: 55px;" class="text-center">Chính</th>
                                            <th style="width: 45px;" class="text-center" title="Bệnh khác">#</th>
                                            <th style="width: 40px;" class="text-center">Xóa</th>
                                        </tr>
                                    </thead>
                                    <tbody id="kb-tbody-icd10"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>
                </div>

                <!-- 11-15. CHỈ ĐỊNH CẬN LÂM SÀNG -->
                <section class="kb-scroll-section section-box kb-lines-5" id="kb-section-chi-dinh" data-kb-section>
                    <div class="kb-title-content-row kb-section-title-content">
                        <div class="section-title kb-compact-title mb-0"><i class="bi bi-clipboard2-pulse-fill me-1"></i> Chỉ định:</div>
                        <div class="kb-title-content-body kb-section-content">
                            <div class="d-flex gap-1 align-items-center mb-1 kb-inline-section-toolbar kb-order-toolbar">
                                <div class="kb-compact-selector kb-order-selector">
                                    <select id="kb-select-dich-vu" placeholder="Công việc / dịch vụ"></select>
                                </div>
                                <span class="badge bg-light text-primary border text-nowrap qlpm-money-total" id="kb-chi-dinh-tong-tien" title="Cộng tiền chỉ định cận lâm sàng">Cộng CĐ: 0 đ</span>
                                <button type="button" class="btn btn-sm btn-primary py-0 px-2 fw-semibold text-nowrap text-white" id="btn-kb-in-chi-dinh" tabindex="-1" title="In riêng phiếu chỉ định theo gửi ngoài / nội bộ">
                                    <i class="bi bi-printer-fill me-1 text-white"></i> In
                                </button>
                                @if (ViewBag.CanSuaKham as bool? == true)
                                {
                                    <button type="button" class="btn btn-sm btn-kb-ky-so py-0 px-2 fw-semibold text-nowrap" id="btn-kb-ky-so-chi-dinh" tabindex="-1" title="Ký toàn bộ chỉ định và mở xem trước khi in">
                                        Ký số
                                    </button>
                                }
                            </div>
                            <div class="table-responsive table-scroll-container border rounded kb-fixed-table-wrap kb-order-scroll">
                                <table class="table table-sm table-bordered m-0 grid-mini qlpm-one-line-head kb-order-table" id="kb-table-chi-dinh">
                                    <thead>
                                        <tr>
                                            <th class="text-center kb-order-datetime-col">Ngày giờ</th>
                                            <th class="kb-sticky-service-col">Công việc / Dịch vụ</th>
                                            <th class="text-center">SL</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-center">KQ</th>
                                            <th class="text-center">Gửi ngoài</th>
                                            <th class="text-center kb-order-actions-col">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody id="kb-tbody-chi-dinh"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 16-22. TOA THUỐC ĐIỀU TRỊ -->
                <section class="kb-scroll-section section-box kb-lines-7 mb-2" id="kb-section-toa-thuoc" data-kb-section>
                    <div class="kb-title-content-row kb-section-title-content">
                        <div class="section-title kb-compact-title mb-0"><i class="bi bi-capsule me-1"></i> Toa thuốc:</div>
                        <div class="kb-title-content-body kb-section-content">
                            <div class="d-flex align-items-center gap-1 mb-1 kb-inline-section-toolbar kb-prescription-toolbar">
                                <div class="input-group input-group-sm kb-so-ngay-toolbar">
                                    <span class="input-group-text py-0" title="Số ngày">SN</span>
                                    <input type="number" id="kb-toa-so-ngay" class="form-control text-center fw-bold py-0" min="1" max="90" value="3" />
                                </div>
                                <label class="input-group input-group-sm kb-loai-toa-picker">
                                    <span class="input-group-text py-0">Loại toa</span>
                                    <select id="kb-loai-toa" class="form-select py-0">
                                        <option value="c" selected>Đơn thuốc cơ bản [DTCB]</option>
                                        <option value="n">Đơn thuốc gây nghiện [DTGN]</option>
                                        <option value="h">Đơn thuốc hướng tâm thần và thuốc tiền chất [DTHTTVTTC]</option>
                                    </select>
                                </label>
                                <span class="badge bg-success-subtle text-success border border-success-subtle qlpm-money-total" id="kb-footer-tong-tien" title="Cộng tiền đơn thuốc">
                                    <i class="bi bi-cash-stack me-1"></i> Cộng Thuốc: <strong>0 đ</strong>
                                </span>
                                <button type="button" class="btn btn-sm btn-primary py-0 px-2 fw-semibold text-nowrap text-white" id="btn-kb-in-toa-thuoc" tabindex="-1" title="In đơn thuốc điều trị">
                                    <i class="bi bi-printer-fill me-1 text-white"></i> In
                                </button>
                                @if (ViewBag.CanLienThongToaThuoc as bool? == true)
                                {
                                    <button type="button" class="btn btn-sm btn-kb-ky-so py-0 px-2 fw-semibold text-nowrap" id="btn-kb-ky-so-toa" tabindex="-1" title="Ký toàn bộ toa thuốc và mở xem trước khi in">
                                        Ký số
                                    </button>
                                }
                            </div>
                            <div class="kb-prescription-picker-shell">
                                <div class="table-responsive table-scroll-container border rounded-top mb-0 kb-fixed-table-wrap kb-prescription-scroll">
                                    <table class="table table-sm table-bordered m-0 toa-grid-table table-input qlpm-one-line-head" id="kb-table-toa-thuoc">
                                    <thead>
                                        <tr class="text-center align-middle bg-light">

                                            <th class="col-sticky-stt text-center" style="width:26px;min-width:26px;max-width:26px;">TT</th>
                                            <th class="col-ngay-ke text-center" style="width:72px;min-width:72px;max-width:72px;">Ngày giờ</th>
                                            <th class="col-sticky-thuoc text-start" style="width:150px;min-width:150px;max-width:150px;">Thuốc</th>
                                            <th style="width:100px;min-width:100px;max-width:100px;" class="text-start">Hoạt chất</th>
                                            <th class="text-center" title="Số ngày">SN</th>
                                            <th class="text-center">ĐVT</th>
                                            <th style="width:55px;min-width:55px;max-width:55px;" class="text-center">Sáng</th>
                                            <th style="width:55px;min-width:55px;max-width:55px;" class="text-center">Trưa</th>
                                            <th style="width:55px;min-width:55px;max-width:55px;" class="text-center">Chiều</th>
                                            <th style="width:55px;min-width:55px;max-width:55px;" class="text-center">Tối</th>
                                            <th style="width:90px;min-width:90px;max-width:90px;" class="text-center" title="Đường dùng">ĐD</th>
                                            <th style="width:180px;min-width:180px;max-width:180px;" class="text-start">Cách dùng khác</th>
                                            <th style="width:90px;min-width:90px;max-width:90px;" class="text-end">Đơn giá</th>
                                            <th style="width:105px;min-width:105px;max-width:105px;" class="text-end">Thành tiền</th>
                                            <th class="col-sticky-dvt-dung text-center" style="width:68px;min-width:68px;max-width:68px;">ĐVT dùng</th>
                                            <th class="col-sticky-sl text-center" style="width:36px;min-width:36px;max-width:36px;">SL</th>
                                            <th class="col-sticky-xoa text-center" style="width:45px;min-width:45px;max-width:45px;">Xóa</th>
                                        </tr>
                                    </thead>
                                        <tbody id="kb-tbody-toa-thuoc"></tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="kb-footer-toathuoc" class="p-2 rounded-bottom bg-light border border-top-0">
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <div class="input-group input-group-sm" style="width:auto;">
                                        <span class="input-group-text bg-white py-0">
                                            <input type="checkbox" class="form-check-input me-1 mt-0" id="kb-chk-tai-kham" checked /> Tái khám:
                                        </span>
                                        <input type="text" id="kb-ngay-tai-kham" class="form-control text-center py-0" style="width: 105px;" placeholder="dd-mm-yyyy" disabled />
                                    </div>
                                </div>
