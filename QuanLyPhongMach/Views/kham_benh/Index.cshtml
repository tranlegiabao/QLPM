<!-- KẾT QUẢ CLS: lưu một file kết quả cho mỗi chỉ định -->
<div class="modal fade" id="modalKetQuaCls" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable cls-result-modal">
        <div class="modal-content">
            <div class="modal-header py-2">
                <div class="min-w-0">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="modal-title mb-0">Kết quả cận lâm sàng</h5>
                        <span class="badge bg-secondary" id="cls-result-status">Chưa có KQ</span>
                    </div>
                    <div class="small text-muted text-truncate" id="cls-modal-title-service"></div>
                    <div class="small text-muted" id="cls-modal-patient"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <strong>T&#224;i li&#7879;u k&#7871;t qu&#7843; CLS</strong>
                        <span class="badge bg-secondary rounded-pill ms-1" id="cls-file-count">0</span>
                    </div>
                    <span class="small text-muted">Một file PDF hoặc ảnh JPG, PNG, WEBP mỗi chỉ định · tối đa 15 MB. Tải file mới sẽ thay thế file hiện tại.</span>
                </div>
                <input class="visually-hidden" type="file" id="cls-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" tabindex="-1" />
                <div class="cls-file-dropzone" id="cls-file-dropzone" role="button" tabindex="0" aria-label="Ch&#7885;n ho&#7863;c th&#7843; file k&#7871;t qu&#7843 CLS">
                    <i class="bi bi-cloud-arrow-up fs-2 text-primary" aria-hidden="true"></i>
                    <div class="fw-semibold">K&#233;o file v&#224;o &#273;&#226;y ho&#7863;c b&#7845;m &#273;&#7875; ch&#7885;n</div>
                    <div class="small text-muted">Ch&#7885;n ho&#7863;c th&#7843; m&#7897;t file. T&#7843;i file m&#7899;i s&#7869; thay file hi&#7879;n t&#7841;i.</div>
                </div>
                <div id="cls-upload-queue" class="mt-2"></div>
                <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-primary" type="button" id="btn-cls-upload" disabled>
                        <i class="bi bi-upload me-1"></i>T&#7843;i file &#273;&#227; ch&#7885;n l&#234;n
                    </button>
                </div>
                <hr class="my-3" />
                <div id="cls-file-list"></div>
            </div>

            <div class="modal-footer py-2 d-flex justify-content-end align-items-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div id="cls-result-preview-overlay" class="cls-result-preview-overlay d-none" role="dialog" aria-modal="true" aria-labelledby="cls-preview-title" aria-hidden="true">
    <div class="cls-result-preview-content">
        <div class="cls-result-preview-header">
            <div class="min-w-0">
                <h4 class="mb-1" id="cls-preview-title">Xem kết quả CLS</h4>
