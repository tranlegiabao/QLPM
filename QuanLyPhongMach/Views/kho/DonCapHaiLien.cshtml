@model QuanLyPhongMach.Models.Printing.Kho.KhoCapPhatPrintModel
@{Layout=null;}
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><style>
body{margin:0;font-family:"Times New Roman",serif;font-size:16px;color:#000}
.copies{width:100%;border-collapse:collapse;table-layout:fixed}.copy{width:50%;vertical-align:top;padding:8px 28px 8px 16px}.copy+ .copy{border-left:1px dashed #999;padding-left:32px;padding-right:16px}
.heading{display:table;width:100%}.heading-company{display:table-cell;width:70%;vertical-align:top}.barcode{display:table-cell;width:30%;text-align:right;font-size:14px;vertical-align:top}.barcode svg{width:140px;height:35px;display:block;margin-left:auto}.barcode__label{display:none}
.code{display:inline-block;border:1px solid #000;padding:0 24px;font-weight:bold}
h1{text-align:center;font-size:25px;line-height:1.1;margin:12px 0 10px}.center{text-align:center}.info{width:100%;border-collapse:collapse;margin:4px 0}.info td{vertical-align:top;padding:0}.line{margin-bottom:4px}.medicine{margin:8px 0 18px;page-break-inside:avoid}.quantity{float:right}.dose{font-style:italic;margin-top:4px}.check{display:inline-block;border:1px solid;width:18px;height:18px;vertical-align:middle;text-align:center}
.signature{margin-left:50%;text-align:center;page-break-inside:avoid}.space{height:90px}.footer{margin-top:25px;page-break-inside:avoid}.warning{text-align:center;font-weight:bold}
</style></head><body>
<table class="copies"><tbody><tr>@for(var i=0;i<2;i++){<td class="copy">@await Html.PartialAsync("~/Views/kho/_DonCapHaiLienNoiDung.cshtml",Model)</td>}</tr></tbody></table>
</body></html>

