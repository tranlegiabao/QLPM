<fieldset class="border rounded p-2 mt-2 d-none ht-nv-ltt-compact" id="ht-nv-ltt">
    <legend class="float-none w-auto small fw-semibold px-1">Tài khoản liên thông của bác sĩ</legend>
    <div class="ht-nv-ltt-grid">
        <div class="ht-nv-field">
            <label for="ht-nv-ltt-ma" class="form-label small">Mã liên thông bác sĩ</label>
            <input id="ht-nv-ltt-ma" class="form-control form-control-sm" maxlength="100" />
        </div>
        <div class="ht-nv-field">
            <label for="ht-nv-ltt-mk" class="form-label small">Mật khẩu liên thông</label>
            <input id="ht-nv-ltt-mk" type="password" class="form-control form-control-sm" maxlength="500" autocomplete="new-password" />
        </div>
        <div class="ht-nv-field">
            <label for="ht-nv-ltt-cchn" class="form-label small">Chứng chỉ hành nghề</label>
            <input id="ht-nv-ltt-cchn" class="form-control form-control-sm" maxlength="100" />
        </div>
    </div>
    <div class="ht-nv-ltt-footer">
        <div class="ht-nv-ltt-help">
            <span>Áp dụng tại cơ sở KCB đang quản lý.</span>
            <span id="ht-nv-ltt-info" class="form-text"></span>
        </div>
        <label class="form-check m-0"><input id="ht-nv-ltt-active" type="checkbox" class="form-check-input" checked /><span class="form-check-label">Sử dụng tài khoản liên thông</span></label>
    </div>
</fieldset>
